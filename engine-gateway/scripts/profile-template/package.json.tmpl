    "m0-exec-script-plugin": "link:{{PLUGIN_DIR}}",
    "m0-fs-read-fence-plugin": "link:{{FENCE_PLUGIN_DIR}}"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
